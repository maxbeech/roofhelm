# Sentry (project roofhelm_web, org maxed-labs). Set on the Helm7 product, not committed.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=maxed-labs
SENTRY_PROJECT=roofhelm_web
# Optional: uploads source maps at build time.
SENTRY_AUTH_TOKEN=

# Pro report (paid PDF). Set on the Helm7 product, not committed. See README, "Pro report".
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=
# Optional: emails the PDF to the buyer from the webhook (OpenHelm Mail).
OPENHELM_API_KEY=
OPENHELM_MAIL_INBOX_ID=
